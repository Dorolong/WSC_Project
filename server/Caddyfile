# WSC Drive Simulator — Caddy 리버스 프록시 설정
#
# 서버에 적용하는 법 (progress/46 Step 3):
#   sudo cp server/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy가 Let's Encrypt 인증서를 자동으로 발급하고 자동으로 갱신한다.
# certbot이나 갱신 cron을 따로 만들지 말 것.
#
# 전제 조건 (안 되어 있으면 인증서 발급이 실패한다):
#   1. wsc-drive.duckdns.org 의 A 레코드가 이 서버의 public IP를 가리킬 것
#   2. 80/tcp, 443/tcp 가 열려 있을 것 — 오라클 Security List "그리고"
#      서버 안의 iptables 둘 다. (오라클은 방화벽이 2겹이다)
#      sudo iptables -I INPUT 6 -m state --state NEW -p tcp --dport 80 -j ACCEPT
#      sudo iptables -I INPUT 6 -m state --state NEW -p tcp --dport 443 -j ACCEPT
#      sudo netfilter-persistent save

wsc-drive.duckdns.org {
	# FastAPI가 정적 파일까지 StaticFiles로 서빙하므로 이 한 줄이면 된다.
	# 여기서 file_server를 따로 두면 경로가 이중 관리되니 하지 말 것.
	reverse_proxy 127.0.0.1:8000

	encode zstd gzip

	header {
		# HSTS — 처음엔 1일로 시작한다.
		# 며칠 문제없이 돌면 max-age=31536000(1년)으로 올릴 것.
		# preload는 붙이지 말 것 — 한번 목록에 오르면 빼는 데 수개월 걸린다.
		Strict-Transport-Security "max-age=86400"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# CSP — 프론트가 실제로 쓰는 출처만 허용한다.
		#   cdn.plot.ly              차트 라이브러리 (index.html의 <script src>)
		#   esm.sh                   supabase-js 동적 import (js/auth.js)
		#   ...supabase.co           인증 / DB 조회
		#   raw.githubusercontent.com  "원본 코드 보기" 기능
		#
		# 프론트에 인라인 <script>·onclick·style 속성이 하나도 없어서
		# script-src에 'unsafe-inline' 없이 갈 수 있다. 이 상태를 유지할 것 —
		# 인라인 스크립트를 새로 추가하면 여기가 깨진다.
		#
		# style-src의 'unsafe-inline'은 Plotly가 런타임에 <style>을 주입해서
		# 필요하다. 빼면 차트 모양이 깨진다.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.plot.ly https://esm.sh; connect-src 'self' https://esm.sh https://wijwbujsihhzzjzawfzp.supabase.co https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		# 서버 종류/버전 노출 제거
		-Server
	}
}

# ── 설정을 실험하는 중이라면 ────────────────────────────────────────
# Let's Encrypt는 발급 실패를 반복하면 rate limit에 걸린다.
# 구성을 여러 번 고쳐가며 시험할 때는 아래 블록의 주석을 풀어서
# staging 인증서(브라우저 경고가 뜨지만 한도가 넉넉함)로 시험하고,
# 다 되면 다시 주석 처리한 뒤 reload 할 것.
#
# {
# 	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
# }
