[Unit]
Description=WSC Drive Simulator (FastAPI, behind Caddy)
After=network.target

[Service]
Type=simple
# 아래 두 경로를 실제 서버의 프로젝트 위치로 바꿔주세요.
WorkingDirectory=/home/ubuntu/WSC_Project
# --host 127.0.0.1 : Caddy 리버스 프록시 뒤에만 노출한다.
#   0.0.0.0으로 두면 Caddy를 세워도 8000 포트로 들어오는 평문 HTTP
#   경로가 그대로 살아있어서 HTTPS 강제가 무의미해진다.
#   방화벽에서 8000을 막는 것과 이중으로 막을 것. (progress/46 F-3)
# --proxy-headers : 프록시가 붙인 X-Forwarded-For를 신뢰해 요청 로그에
#   실제 접속자 IP가 남게 한다. 없으면 전부 127.0.0.1로 찍혀 로그가
#   쓸모없어진다. 신뢰 대상은 로컬 프록시로 한정한다.
ExecStart=/home/ubuntu/WSC_Project/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
User=ubuntu

[Install]
WantedBy=multi-user.target
